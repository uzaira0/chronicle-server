    <!-- Mockito Kotlin inline reified matchers generate unreachable primitive-wrapper
         casts. This filter is attached only to the test source set. -->
    <Match>
        <Bug pattern="BC_IMPOSSIBLE_CAST"/>
    </Match>

    <!--
      Kotlin emits a null guard on every lateinit field read. In these setup
      methods SpotBugs treats later compiler-generated guards as redundant.
    -->
